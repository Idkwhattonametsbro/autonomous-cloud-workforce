# ─────────────────────────────────────────────────
# Autonomous Cloud Workforce — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# In production (GitHub Actions), set these as Repository Secrets instead.

# ─── Required API Keys ───
# Groq: Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter: Get your free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Agent Configuration ───
# The high-level goal the agent works toward each cycle
AGENT_GOAL=Check for new client inquiries, draft professional responses, and log all completed tasks.

# Enable verbose logging (true/false)
VERBOSE=true

# ─── Optional Integration Keys ───
# Uncomment and fill in the services you want to connect:

# TAVILY_API_KEY=your_tavily_key_here          # Web search
# HUBSPOT_API_KEY=your_hubspot_key_here        # CRM
# GMAIL_CREDENTIALS_PATH=./credentials.json    # Gmail integration
